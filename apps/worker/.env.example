# Worker env (salin dari root .env)
# Supabase: runtime -> transaction pooler (port 6543) + "?pgbouncer=true&connection_limit=1";
# db:* -> session pooler :5432 (packages/db/.env).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_analyst?schema=public"
DISCORD_BOT_TOKEN="your-bot-token"
DISCORD_CLIENT_ID="your-client-id"
DISCORD_GUILD_ID="your-guild-id"
DISCORD_NOTIFY_CHANNEL_ID="channel-id"
DISCORD_SIGNAL_CHANNEL_ID="channel-id"
DISCORD_NEWS_CHANNEL_ID="channel-id"
DISCORD_ADMIN_CHANNEL_ID="channel-id"
DISCORD_OWNER_ID="your-discord-user-id"
BOT_MODE="SIGNAL_ONLY"
BOT_TIMEZONE="Asia/Jakarta"
LOG_LEVEL="info"
MARKET_DATA_PROVIDER="yahoo"
TWELVE_DATA_API_KEY=""

# --- Fundamental & profil emiten ---
# Otomatis via Yahoo tiap hari kerja 16:45 WIB. Backfill manual:
#   npm run fundamentals:sync --workspace @stock-analyst/worker

# --- Broker summary & foreign flow (PRD 10.3) ---
# auto   = sectors kalau SECTORS_API_KEY diisi, lalu http kalau BROKER_API_URL diisi,
#          kalau tidak pakai data contoh deterministik
# http   = wajib punya BROKER_API_URL
# sample = selalu pakai data contoh deterministik
BROKER_PROVIDER="auto"
# Template endpoint JSON, wajib memuat placeholder {ticker} (opsional {date}).
# Contoh: https://api.contoh.id/broker-summary?symbol={ticker}&date={date}
BROKER_API_URL=""
BROKER_API_KEY=""
# Jumlah hari bursa terakhir yang disinkronkan tiap kali job broker jalan (1-60)
BROKER_SYNC_DAYS="10"
# Sectors Financial API (opsional, berbayar) — broker summary per saham + foreign flow.
SECTORS_API_KEY=""

# --- Telegram (opsional, channel notifikasi kedua) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Berita & AI (PRD 4.5/4.7) ---
# Daftar URL RSS dipisah koma; kosong = feed default.
NEWS_RSS_URLS=""
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-5"
ANTHROPIC_BASE_URL=""

# --- Corporate Action & Dividen (PRD 4.4) ---
# auto   = coba kalender resmi IDX, lalu http kalau CORPORATE_ACTION_API_URL diisi,
#          terakhir fallback ke data contoh deterministik
# idx    = kalender resmi IDX (gratis, tanpa key) + fallback contoh
# http   = wajib punya CORPORATE_ACTION_API_URL
# sample = selalu pakai data contoh deterministik
CORPORATE_ACTION_PROVIDER="auto"
CORPORATE_ACTION_API_URL=""
CORPORATE_ACTION_API_KEY=""

# --- Kalender bursa (FR-DATA-005) ---
MARKET_HOLIDAYS=""

# Email user owner (single-user)
OWNER_EMAIL="owner@xerastock.local"
