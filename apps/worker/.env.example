# Worker env (saldo dari root .env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_analyst?schema=public"
DISCORD_BOT_TOKEN="your-bot-token"
DISCORD_CLIENT_ID="your-client-id"
DISCORD_GUILD_ID="your-guild-id"
DISCORD_NOTIFY_CHANNEL_ID="channel-id"
DISCORD_SIGNAL_CHANNEL_ID="channel-id"
DISCORD_NEWS_CHANNEL_ID="channel-id"
DISCORD_ADMIN_CHANNEL_ID="channel-id"
DISCORD_OWNER_ID="your-discord-user-id"
REDIS_URL="redis://localhost:6379"
BOT_MODE="SIGNAL_ONLY"
BOT_TIMEZONE="Asia/Jakarta"
LOG_LEVEL="info"
MARKET_DATA_PROVIDER="yahoo"
TWELVE_DATA_API_KEY=""

# Broker summary & foreign flow (PRD 10.3)
# auto   = pakai http kalau BROKER_API_URL diisi, kalau tidak pakai data contoh
# http   = wajib punya BROKER_API_URL
# sample = selalu pakai data contoh deterministik
BROKER_PROVIDER="auto"
# Template endpoint JSON, wajib memuat placeholder {ticker} (opsional {date}).
# Contoh: https://api.contoh.id/broker-summary?symbol={ticker}&date={date}
BROKER_API_URL=""
BROKER_API_KEY=""
# Jumlah hari bursa terakhir yang disinkronkan tiap kali job broker jalan (1-60)
BROKER_SYNC_DAYS="10"