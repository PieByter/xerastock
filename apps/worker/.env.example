# Worker env (saldo dari root .env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_analyst?schema=public"
DISCORD_BOT_TOKEN="your-bot-token"
DISCORD_CLIENT_ID="your-client-id"
DISCORD_GUILD_ID="your-guild-id"
DISCORD_NOTIFY_CHANNEL_ID="channel-id"
DISCORD_ADMIN_CHANNEL_ID="channel-id"
DISCORD_OWNER_ID="your-discord-user-id"
REDIS_URL="redis://localhost:6379"
BOT_MODE="SIGNAL_ONLY"
BOT_TIMEZONE="Asia/Jakarta"
LOG_LEVEL="info"