# Web app env (saldo dari root .env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_analyst?schema=public"

# --- Keamanan dashboard (opsional, WAJIB untuk deploy publik) ---
# Kosong = dashboard terbuka tanpa login. Diisi = semua halaman dilindungi login.
# Catatan: nilai ini dibaca saat build (middleware Next.js), jadi set sebelum `next build`.
DASHBOARD_PASSWORD=""

# --- AI Assistant (opsional) ---
# Tanpa key, halaman /ai-assistant & ringkasan berita memakai jawaban deterministik (mode demo).
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-5"

# Email user owner (single-user) untuk watchlist & strategi
OWNER_EMAIL="owner@xerastock.local"