# ============================================================
# Stock Analyst — Environment Variables (root example)
# Salin ke .env dan isi sesuai environment masing-masing.
# ============================================================

# --- Database (Supabase PostgreSQL / Postgres lokal) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_analyst?schema=public"

# --- Supabase (Auth + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Discord Bot ---
DISCORD_BOT_TOKEN="your-bot-token"
DISCORD_CLIENT_ID="your-client-id"
DISCORD_GUILD_ID="your-guild-id"          # untuk dev (guild commands)
DISCORD_NOTIFY_CHANNEL_ID="channel-id"    # channel notifikasi default
DISCORD_SIGNAL_CHANNEL_ID="channel-id"    # #sinyal — sinyal & eksekusi trade
DISCORD_NEWS_CHANNEL_ID="channel-id"      # #news — ringkasan berita
DISCORD_ADMIN_CHANNEL_ID="channel-id"     # channel log/admin
DISCORD_OWNER_ID="your-discord-user-id"   # owner (binding user)

# --- Scheduler / Queue ---
REDIS_URL="redis://localhost:6379"
# Upstash Redis (opsional, untuk Vercel-friendly): REDIS_URL="rediss://default:pass@host:port"

# --- Data Provider ---
# Yahoo Finance gratis (default). Twelve Data sebagai fallback (opsional, butuh key).
MARKET_DATA_PROVIDER="yahoo"              # yahoo | twelvedata (primary)
TWELVE_DATA_API_KEY=""                    # opsional — aktifkan fallback Twelve Data

# --- Broker Summary & Foreign Flow ---
# auto = http kalau BROKER_API_URL diisi, kalau tidak pakai data contoh deterministik
BROKER_PROVIDER="auto"                    # auto | http | sample
# Template endpoint JSON, wajib memuat placeholder {ticker} (opsional {date})
BROKER_API_URL=""                         # mis. https://api.contoh.id/broker?symbol={ticker}&date={date}
BROKER_API_KEY=""                         # dikirim sebagai Authorization: Bearer <key>
BROKER_SYNC_DAYS="10"                     # hari bursa terakhir yang disinkronkan (1-60)

# --- Bot / Trading ---
BOT_MODE="SIGNAL_ONLY"                    # SIGNAL_ONLY | PAPER | LIVE
BOT_TIMEZONE="Asia/Jakarta"
TRADING_DAILY_LOSS_LIMIT_PCT="2"
TRADING_RISK_PER_POSITION_PCT="1"
TRADING_MAX_POSITIONS="5"

# --- Berita (PRD 4.5) ---
# Daftar URL RSS dipisah koma. Kosong = pakai feed default (Kontan, CNBC Indonesia, Bisnis).
NEWS_RSS_URLS=""

# --- AI (opsional, PRD 4.7) ---
# Tanpa key: ringkasan berita & asisten AI memakai fallback deterministik (tanpa biaya API).
# Dipakai juga oleh `npm run commit:auto -- --ai` untuk menulis subjek commit.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-5"
ANTHROPIC_BASE_URL=""                     # opsional — arahkan ke proxy/gateway sendiri

# Email user owner (single-user) untuk watchlist & strategi
OWNER_EMAIL="owner@xerastock.local"

# --- Logging ---
LOG_LEVEL="info"